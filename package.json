{
  "name": "@beltype/cli",
  "version": "0.1.4",
  "description": "beltype, the command line: a finished HTML document printed to PDF by Cicero and Caster in Chromium's headless shell.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BelType/cli.git"
  },
  "homepage": "https://codeberg.org/BelType/cli",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "beltype": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'",
    "prepare": "npm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@beltype/cicero",
      "@beltype/caster",
      "@beltype/common"
    ]
  },
  "dependencies": {
    "@beltype/caster": "0.1.6",
    "@beltype/cicero": "0.1.5",
    "@beltype/common": "0.1.2",
    "mupdf": "1.28.1",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@beltype/specimens": "0.1.0",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2"
  },
  "bugs": {
    "url": "https://codeberg.org/BelType/cli/issues"
  }
}
