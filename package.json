{
  "name": "@beltype/cli",
  "version": "0.1.0",
  "private": true,
  "description": "beltype, the command line: a finished HTML document printed to PDF by Cicero and Caster in Chromium's headless shell.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/BelType/cli.git"
  },
  "homepage": "https://codeberg.org/BelType/cli",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "beltype": "./dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'",
    "prepare": "npm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@beltype/cicero",
      "@beltype/caster",
      "@beltype/common"
    ]
  },
  "dependencies": {
    "@beltype/caster": "git+ssh://git@codeberg.org/BelType/caster.git#v0.1.1",
    "@beltype/cicero": "git+ssh://git@codeberg.org/BelType/cicero.git#v0.1.3",
    "@beltype/common": "git+ssh://git@codeberg.org/BelType/common.git#v0.1.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "mupdf": "1.28.1",
    "typescript": "7.0.2"
  }
}
