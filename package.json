{
  "name": "@beltype/cli",
  "version": "0.1.10",
  "description": "beltype, the command line: a finished HTML document printed to PDF by Cicero and Caster in Chromium's headless shell.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BelType/cli.git"
  },
  "homepage": "https://codeberg.org/BelType/cli",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "beltype": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'",
    "prepare": "npm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@beltype/caster",
      "@beltype/cicero",
      "@beltype/common",
      "esbuild"
    ]
  },
  "dependencies": {
    "@beltype/caster": "0.2.7",
    "@beltype/cicero": "0.1.12",
    "@beltype/common": "0.1.2",
    "playwright-core": "1.63.0"
  },
  "peerDependencies": {
    "mupdf": "1.28.1"
  },
  "peerDependenciesMeta": {
    "mupdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@beltype/specimens": "0.1.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "linkedom": "0.18.14",
    "mupdf": "1.28.1",
    "prosemirror-stores": "git+https://codeberg.org/egildo/prosemirror-stores.git#3b281922616bf674c9338de73626b98b8f0a1d8d",
    "typescript": "7.0.2"
  },
  "bugs": {
    "url": "https://codeberg.org/BelType/cli/issues"
  }
}
